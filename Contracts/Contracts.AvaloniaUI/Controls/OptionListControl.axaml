<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Contracts.AvaloniaUI.Controls.OptionListControl"
             xmlns:infrastructure="using:Contracts.AvaloniaUI.Infrastructure"
             xmlns:controls="using:Contracts.AvaloniaUI.Controls"
             x:DataType="controls:OptionListControl">
    <ListBox ItemsSource="{Binding Operations, RelativeSource={RelativeSource AncestorType=controls:OptionListControl}}"
             SelectedItem="{Binding SelectedOption, RelativeSource={RelativeSource AncestorType=controls:OptionListControl}, Mode=TwoWay}">
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="infrastructure:IOperation">
                <TextBlock Text="{Binding Title}" Padding="5" FontSize="13" />
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>

